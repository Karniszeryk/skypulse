# Podmień skypulse.twojadomena.pl na własną domenę (np. skypulse.pl lub lotyekipy.pl)
# Caddy automatycznie wygeneruje i odnowi darmowy certyfikat SSL/TLS 1.3 (Let's Encrypt)!
{$DOMAIN:localhost} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy app:8000
}
